@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#070830;--surface:#0e0f45;--text:#f2f1ff;--muted:#a9abd1;--line:#24266b}}
:root[data-theme="dark"]{--bg:#070830;--surface:#0e0f45;--text:#f2f1ff;--muted:#a9abd1;--line:#24266b}
html{scroll-behavior:smooth;scroll-padding-top:calc(70px + env(safe-area-inset-top,0px))}
*{box-sizing:border-box}
body{margin:0;font-family:Poppins,system-ui,sans-serif;background:var(--bg);color:var(--text);line-height:1.6}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--navy);z-index:60}
img{max-width:100%}
a{color:inherit}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:space-between;padding:8px 5%}
header img{height:46px;width:auto;border-radius:6px;display:block}
nav{display:flex;gap:22px}
nav a{text-decoration:none;font-size:.9rem;font-weight:600;opacity:.9}
nav a:hover{color:var(--gold)}
.menu{display:none;background:none;border:1px solid #ffffff55;color:#fff;border-radius:8px;padding:6px 12px;font:inherit}
.btn{display:inline-block;background:var(--gold);color:#1a1200;font-weight:700;text-decoration:none;padding:12px 24px;border-radius:999px;border:0;cursor:pointer;font:inherit;font-weight:700;transition:transform .2s}
.btn:hover{transform:translateY(-2px)}
.btn.ghost{background:transparent;color:#fff;border:2px solid #fff}
section{padding:80px 5%;max-width:1150px;margin:auto}
h2{font-size:clamp(1.6rem,4vw,2.3rem);margin:0 0 10px}
.sub{color:var(--muted);max-width:640px;margin:0 0 32px}
.tag{color:var(--gold);font-weight:700;letter-spacing:.15em;font-size:.8rem;text-transform:uppercase}
#hero{max-width:none;min-height:88vh;display:flex;align-items:center;color:#fff;position:relative;overflow:hidden;background:var(--navy)}
#bgfx{position:absolute;inset:0;transition:background 1s;background:radial-gradient(circle at 80% 20%,#5b21b6aa,transparent 55%),radial-gradient(circle at 10% 90%,#f5a70033,transparent 45%)}
#person{position:absolute;right:4%;bottom:0;height:78%;opacity:.28;transition:transform .3s,filter 1s}
.hero-in{position:relative;max-width:1150px;margin:auto;width:100%}
.hero-in h1{font-size:clamp(2.1rem,6vw,3.8rem);line-height:1.1;margin:10px 0 16px;max-width:700px}
.hero-in h1 span{color:var(--gold)}
.hero-in p{max-width:540px;opacity:.85;margin-bottom:26px}
.row{display:flex;gap:12px;flex-wrap:wrap}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:22px}
.card h3{margin:6px 0}
.card .n{color:var(--gold);font-weight:700}
details{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:0 20px;margin-bottom:12px;transition:border-color .2s}
details[open]{border-color:var(--purple)}
summary{cursor:pointer;font-weight:700;padding:18px 0;list-style:none;display:flex;justify-content:space-between;gap:12px;font-size:1.05rem}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";color:var(--gold);font-size:1.4rem;line-height:1}
details[open] summary::after{content:"\2212"}
details ul{margin:0 0 14px;padding-left:20px;color:var(--muted)}
details .btn{margin-bottom:20px;font-size:.9rem;padding:10px 20px}
.reveal{opacity:0;transform:translateY(24px);transition:.7s}
.reveal.in{opacity:1;transform:none}
form{display:grid;gap:12px;max-width:520px}
input,select,textarea{font:inherit;padding:12px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--text);width:100%}
.stars button{background:none;border:0;font-size:1.6rem;color:var(--line);cursor:pointer}
.stars button.on{color:var(--gold)}
#cta{max-width:none;background:linear-gradient(120deg,#3b0f8c,#6d28d9);color:#fff;text-align:center}
#cta p{max-width:520px;margin:0 auto 22px;opacity:.9}
footer{background:var(--navy);color:#cfd0ee;padding:44px 5% calc(24px + env(safe-area-inset-bottom,0px))}
.fgrid{max-width:1150px;margin:auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px}
footer h4{color:#fff;margin:0 0 8px}
footer a{display:block;text-decoration:none;margin:4px 0}
.copy{max-width:1150px;margin:24px auto 0;border-top:1px solid #ffffff22;padding-top:14px;font-size:.8rem}
.wa{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:40;background:#25d366;color:#fff;border-radius:999px;padding:12px 18px;font-weight:700;text-decoration:none;box-shadow:0 6px 18px #0004}
@media(max-width:760px){.menu{display:block}nav{display:none;position:absolute;top:100%;left:0;right:0;background:var(--navy);flex-direction:column;padding:16px 5%;gap:14px}nav.open{display:flex}#person{opacity:.15}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto}.reveal{opacity:1;transform:none}}
</style></head><body>
